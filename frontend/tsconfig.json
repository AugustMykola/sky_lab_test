{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "vite/client",
      "vite-plugin-pwa/client"
    ],
    "paths": {
      "@log-analyzer/domain": [
        "../packages/log-domain/src/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
