{
  "name": "log-analyzer-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "predev": "npm run build -w @log-analyzer/domain",
    "prebuild": "npm run build -w @log-analyzer/domain",
    "pretest": "npm run build -w @log-analyzer/domain",
    "pretypecheck": "npm run build -w @log-analyzer/domain"
  },
  "dependencies": {
    "@log-analyzer/domain": "1.0.0",
    "better-sqlite3": "^13.0.3",
    "dayjs": "^1.11.23",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
